# ==================== 掌柜智库 Shopkeeper Brain · 环境变量模板 ====================
# 用法：复制本文件为 .env，再按本机实际环境填写。
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
# 注意：.env 已在 .gitignore 中排除，请勿把真实密钥提交到仓库。

# -------------------- 大模型（DeepSeek）--------------------
# 视觉/多模态模型名（PDF 解析与图片理解使用）
VL_MODEL=deepseek-v4.1-flash

# 查询侧 LLM：langchain_deepseek.ChatDeepSeek 默认读取下面两个变量
# 走官方 API 时只需 DEEPSEEK_API_KEY；走自建网关再补 DEEPSEEK_API_BASE
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_BASE=

# -------------------- 对象存储（MinIO）--------------------
# 导入流程把解析后的 PDF / 图片放到 MinIO；查询流程按需回取
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base

# -------------------- 向量库（Milvus）--------------------
# 混合检索（BGE-M3 dense + sparse、WeightedRanker）承载库
MILVUS_URL=http://127.0.0.1:19530

# 三类集合名（首次导入会自动创建，保持默认即可）
ITEM_NAME_COLLECTION=item_name_collection
ENTITY_NAME_COLLECTION=entity_collection
CHUNKS_COLLECTION=chunks_collection

# -------------------- 知识图谱（Neo4j）--------------------
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# 知识图谱检索的规模上限（按需调整）
KG_MAX_SEED_CANDIDATES=3
KG_MAX_TOTAL_SEEDS=10
KG_MAX_TOTAL_CHUNKS=50
KG_MAX_TRIPLES_PER_SEED=100
KG_MAX_TOTAL_TRIPLES=100

# -------------------- 融合与重排序 --------------------
# RRF 融合参数
RRF_MAX_RESULTS=10
RRF_K=60

# BGE 重排序模型路径（本机绝对路径，按实际修改）
BGE_RERANKER_LARGE=F:\bge_rerank_model
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1

# 项目（产品）名诊断开关
ITEM_NAME_DIAG=1

# -------------------- 历史会话（MongoDB）--------------------
# answer_output_node 写入历史、GET /history 读取、item_name 回填均依赖；
# 未配置时历史记录功能整体不可用（服务仍可启动）
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb001

# -------------------- MCP 网络搜索 --------------------
# mcp_search_node 使用的 DashScope 兼容地址（可留空，见节点内默认值）
MCP_DASHSCOPE_BASE_URL=
